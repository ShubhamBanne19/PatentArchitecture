rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ─── Helper functions ────────────────────────────────────────────────
    
    /// Check if user is authenticated
    function signedIn() {
      return request.auth != null;
    }

    /// Check if request is from the user owning a document
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    /// Get the current user's profile document
    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    /// Check if profile exists
    function profileExists() {
      return userProfile().data != null;
    }

    /// Get user's subscription tier
    function userTier() {
      return profileExists() ? userProfile().data.subscription.tier : 'free';
    }

    /// Get user's subscription status
    function userStatus() {
      return profileExists() ? userProfile().data.subscription.status : 'free';
    }

    /// Check if user has active subscription
    function hasActiveSubscription() {
      return signedIn()
        && profileExists()
        && userStatus() == 'active';
    }

    /// Bounded, non-empty string (defends against field-type spoofing and
    /// unbounded-size abuse from clients that bypass the app's JS and call
    /// the SDK/REST API directly)
    function isBoundedString(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }

    /// Check if user can read premium content at given access level
    function canReadPremium(accessLevel) {
      return hasActiveSubscription()
        && (
          (accessLevel == 'basic' && userTier() in ['basic', 'premium'])
          || (accessLevel == 'premium' && userTier() == 'premium')
        );
    }

    // ─── Users collection ────────────────────────────────────────────────
    // Storage: users/{uid} documents with profile and subscription state
    // Security: Users can only read/write their own profiles
    // Server-side fields: subscription (granted via tools/grant-access.mjs /
    // admin console only — see MANUAL_ACCESS.md)

    match /users/{uid} {
      /// Allow create: New user registration via auth service
      /// Enforces initial state: tier=free, status=free, role=user, and that
      /// every field is the right type/size and timestamps are server-set
      /// (not client-spoofed via a direct SDK/REST call).
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.subscription.tier == 'free'
        && request.resource.data.subscription.status == 'free'
        && request.resource.data.subscription.keys().hasOnly(['tier', 'status', 'currentPeriodEnd'])
        && isBoundedString(request.resource.data.email, 320)
        && isBoundedString(request.resource.data.name, 200)
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastLoginAt == request.time
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'name', 'role', 'subscription',
          'createdAt', 'lastLoginAt'
        ]);

      /// Allow read: User can read their own profile
      allow read: if isOwner(uid);

      /// Allow update: User can only touch name/email/lastLoginAt, with valid
      /// types/sizes and a server-set timestamp. Everything else — role,
      /// subscription, uid, createdAt, or any new field — is rejected by the
      /// hasOnly() allowlist (positive allowlist, not just a role/subscription
      /// blocklist, so field-pollution can't slip in via new keys either).
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'lastLoginAt'])
        && request.resource.data.role == resource.data.role
        && request.resource.data.subscription == resource.data.subscription
        && isBoundedString(request.resource.data.email, 320)
        && isBoundedString(request.resource.data.name, 200)
        && request.resource.data.lastLoginAt == request.time;

      /// Deny delete: Users cannot delete their own accounts (admin-only)
      allow delete: if false;
    }

    // ─── Premium Content collection ──────────────────────────────────────
    // Storage: Document per chapter extra, prompt pack, download, etc.
    // Fields: id, chapterId, title, type, accessLevel ('basic'|'premium'),
    //         bodyMarkdown, published, updatedAt
    // Security: Published content readable by active subscribers matching tier
    
    match /premiumContent/{contentId} {
      /// Allow read: Published content only, access control by subscription tier
      allow read: if resource.data.published == true 
        && canReadPremium(resource.data.accessLevel);

      /// Deny all writes: Content managed by admin only
      allow write: if false;
    }

    // ─── Access Requests collection ──────────────────────────────────────
    // Storage: accessRequests/{uid} — a buyer's manual one-time-payment claim.
    // Fields: uid, email, name, amount, method, reference, note, status,
    //         createdAt, reviewedAt
    // Security: A user may create/update ONLY their own request and ONLY with
    //   status == 'pending'. They can never self-approve — access is granted by
    //   an admin editing users/{uid}.subscription in the Firebase console.

    match /accessRequests/{uid} {
      /// Allow read: user can view their own request status
      allow read: if isOwner(uid);

      /// Allow create/update: only your own doc, only as a pending claim, with
      /// bounded/typed fields. reviewedAt may never move away from its current
      /// value — it's admin/console-only, set exclusively by
      /// tools/grant-access.mjs via the Admin SDK (which bypasses these rules
      /// entirely), so a resubmission can't clobber an admin's approve/reject
      /// by resetting status back to 'pending' with reviewedAt wiped to null.
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.method in ['upi', 'bank']
        && isBoundedString(request.resource.data.email, 320)
        && isBoundedString(request.resource.data.name, 200)
        && isBoundedString(request.resource.data.reference, 200)
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 10000000
        && (request.resource.data.note == null || isBoundedString(request.resource.data.note, 2000))
        && request.resource.data.createdAt == request.time
        && request.resource.data.reviewedAt == (resource != null ? resource.data.reviewedAt : null)
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'name', 'amount', 'method', 'reference', 'note',
          'status', 'createdAt', 'reviewedAt'
        ]);

      /// Deny delete: audit trail is admin/console-only
      allow delete: if false;
    }

    // ─── Catch-all ───────────────────────────────────────────────────────
    // Explicitly deny access to any undeclared collections
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
